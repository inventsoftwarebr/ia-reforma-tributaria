# =============================================================================
# IA da Reforma Tributária — variáveis de ambiente
# Copie para .env.local. Nunca comite .env.local.
# =============================================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NUNCA expor ao browser.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Postgres — Supavisor em TRANSACTION mode (porta 6543). Ver CLAUDE.md §9.
#   postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:6543/postgres
# -----------------------------------------------------------------------------
DATABASE_URL=
# Só para drizzle-kit (porta 5432).
DIRECT_URL=

# -----------------------------------------------------------------------------
# WhatsApp — gateway (CLAUDE.md §14)
# -----------------------------------------------------------------------------
WHATSAPP_GATEWAY=evolution            # evolution | cloud_api
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Allowlist da instância. Nunca deixar vazio.
EVOLUTION_INSTANCE=
# Segredo do webhook de entrada. Configure o Evolution para enviar ?token=<segredo>
# na URL do webhook ou o header x-invent-token. Ver CLAUDE.md §5.
EVOLUTION_WEBHOOK_SECRET=

# WhatsApp Cloud API (quando WHATSAPP_GATEWAY=cloud_api)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# -----------------------------------------------------------------------------
# Fila / debounce do turno
# -----------------------------------------------------------------------------
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
TURN_DEBOUNCE_SECONDS=7

# -----------------------------------------------------------------------------
# IA
# -----------------------------------------------------------------------------
AI_PROVIDER=
AI_MODEL=
AI_EMBEDDING_MODEL=
AI_MAX_TOKENS_PER_TURN=1200
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# -----------------------------------------------------------------------------
# Limites e custo
# -----------------------------------------------------------------------------
RATE_LIMIT_MESSAGES_PER_DAY=50
MAX_COST_USD_PER_CONVERSATION=0.50

# -----------------------------------------------------------------------------
# Conversão
# -----------------------------------------------------------------------------
SIMULATOR_URL=https://lp.inventsoftware.com.br/simulador-reforma-tributaria/
SIMULATOR_UTM=utm_source=ia+whatsapp+mkt&utm_campaign=simulador+da+reforma+tributaria
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PORTAL_ID=
HUBSPOT_WHATSAPP_PIPELINE_ID=

# -----------------------------------------------------------------------------
# Observabilidade
# -----------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
