# =============================================================================
# IA da Reforma Tributaria - Invent Software
# Copie para .env.local. Nunca comite .env.local.
# =============================================================================

# URL publica da app. A fila usa para chamar o worker de volta.
APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Ignora RLS. NUNCA expor ao navegador.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Postgres - Supavisor em TRANSACTION mode (porta 6543) para a aplicacao.
#   postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
# -----------------------------------------------------------------------------
DATABASE_URL=
# Porta 5432, so para migration e scripts (rodam fora de serverless).
DIRECT_URL=

# -----------------------------------------------------------------------------
# WhatsApp (Evolution API na VPS/EasyPanel)
# -----------------------------------------------------------------------------
WHATSAPP_GATEWAY=evolution
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
# Allowlist da instancia. Nunca vazio.
EVOLUTION_INSTANCE=
# Segredo do webhook de entrada (minimo 16 caracteres): openssl rand -hex 32
# Configure o Evolution para chamar ?token=<segredo> ou o header x-invent-token.
EVOLUTION_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Fila / debounce do turno (Upstash QStash)
# Sem QSTASH_TOKEN o turno roda inline: serve em dev, nao em producao.
# -----------------------------------------------------------------------------
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
TURN_DEBOUNCE_SECONDS=7

# -----------------------------------------------------------------------------
# Modelo de conversa
# -----------------------------------------------------------------------------
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5
AI_MAX_TOKENS_PER_TURN=1200
ANTHROPIC_API_KEY=
# Se AI_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=

# -----------------------------------------------------------------------------
# Embeddings da base de conhecimento
# Trocar de modelo muda a dimensao do vetor: exige migration + reingestao.
# -----------------------------------------------------------------------------
AI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
KB_MATCH_COUNT=8

# -----------------------------------------------------------------------------
# Limites
# -----------------------------------------------------------------------------
RATE_LIMIT_MESSAGES_PER_DAY=50

# -----------------------------------------------------------------------------
# Conversao
# -----------------------------------------------------------------------------
SIMULATOR_URL=https://lp.inventsoftware.com.br/simulador-reforma-tributaria/
SIMULATOR_UTM=utm_source=ia+whatsapp+mkt&utm_campaign=simulador+da+reforma+tributaria

# HubSpot (opcional: sem token o outbox acumula e o console avisa)
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PIPELINE_ID=
HUBSPOT_DEAL_STAGE_ID=

# Protege /api/cron/* na Vercel: openssl rand -hex 32
CRON_SECRET=
